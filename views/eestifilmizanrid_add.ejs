<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Žanrite lisamine</title>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_TA.png" alt="Veebiprogrammeerimine">
    <h1>Žanrite lisamine</h1>
    <hr>
    <ul>
        <li><a href="/">Tagasi avalehele</a></li>
        <li><a href="/eestifilm">Eesti filmi avaleht</a></li>
        <li><a href="/eestifilm/filmid_add">Filmide lisamine</a></li>
    </ul>
    <hr>
    <form method="POST">
        <label for="genreNameInput">Žanri nimi</label>
        <input id="genreNameInput" name="genreNameInput" type="text" maxlength="50"
        value="<%= genreName || '' %>" required>
        <br>
        <label for="descriptionInput">Žanri kirjeldus</label>
        <textarea id="descriptionInput" name="descriptionInput" maxlength="1000"><%= description || '' %></textarea>
        <br>
        <input type="submit" value="Salvesta">
    </form>
    <p><%= notice %></p>
</body>
</html>
