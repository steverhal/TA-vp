<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Fotogalerii</title>
	<link rel="stylesheet" href="/style/gallery.css">
	<script src="/script/gallery.js" defer></script>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_TA.png" alt="Veebiprogrammeerimine">
    <h1>Fotogalerii</h1>
    <hr>
    <ul>
        <li><a href="/home">Tagasi avalehele</a></li>
		<li><a href="/logout">Logi välja</a></li>
        <li><a href="/galleryPhotoUpload">Lae foto üles</a></li>
    </ul>
    <hr>
	<dialog id="modal" class="modalarea">
		<span id="modalClose" class="modalclose">&times;</span>
		<div class="modalhorizontal">
			<div class="modalvertical">
				<p id="modalCaption"></p>
				<img id="modalImage" src="../pic/empty.png" alt="galeriipilt">
				</div>
			</div>
	</dialog>

	<div id="gallery" class="gallery">
    <%if (photos.length > 0) {%>
        <%photos.forEach(photo => {%>
            <img src="/gallery/thumbs/<%=photo.filename%>"
                 alt="<%= photo.alttext || 'Galerii foto' %>"
				 class="thumbs" data-id="<%=photo.id%>" data-filename="<%=photo.filename%>">
        <% }); %>
    <% } else { %>
        <p>Galeriis pole veel fotosid.</p>
    <% } %>
	</div>
</body>
</html>