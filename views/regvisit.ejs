<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Registreeri enda külastus</title>
</head>
<body>
	<img src="pic/veebiprogrammeerimine_2026_TA.png" alt="">
	<h1>Külastused</h1>
	<hr>
	<p>Registreeri oma külastus sellel veebilehel.</p>
	<form method="POST">
		<label for="nameInput">Nimi</label>
		<input id="nameInput" type="text" name="nameInput" placeholder="Kirjuta siia oma nimi ...">
		<br>
		<input id="regSubmit" type="submit" name="regSubmit" value="Salvesta">
	</form>
	<hr>
	    <p>
        Viimati registreeriti külastus <%= date %>,
        kell <%= time %> kui seda tegi <%= name %>.
	<hr>
    </p>
	<ul>
		<li><a href="/">Tagasi avalehele</a></li>
	</ul>
</body>
</html>