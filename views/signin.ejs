<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Stever Hallika, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
	<h1>Sisselogimine</h1>
	<ul>
		<li><a href="/">Tagasi avalehele</a></li>
	</ul>
	<hr>
	<form method="POST">
		<label for="emailInput">E-mail (kasutajatunnus)</label>
		<input type="email" id="emailInput" name="emailInput" placeholder="Sinu e-mail ...." required>
		<br>
		<label for="passwordInput">Salasõna</label>
		<input type="password" id="passwordInput" name="passwordInput" required>
		<br>
		<input type="submit" id="userSubmit" name="userSubmit" value="Logi sisse">
	</form>
	<p><%= notice %></p>
</body>
</html>