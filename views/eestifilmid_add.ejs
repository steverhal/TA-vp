<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Filmide lisamine</title>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_TA.png" alt="Veebiprogrammeerimine">
    <h1>Filmide lisamine</h1>
    <hr>
    <ul>
        <li><a href="/">Tagasi avalehele</a></li>
        <li><a href="/eestifilm">Eesti filmi avaleht</a></li>
        <li><a href="/eestifilm/inimesed">Filmiinimesed</a></li>
        <li><a href="/eestifilm/zanrid_add">Žanrite lisamine</a></li>
    </ul>
    <hr>
    <form method="POST">
        <label for="titleInput">Filmi pealkiri</label>
        <input id="titleInput" name="titleInput" type="text" maxlength="100"
        value="<%= title || '' %>" required>
        <br>
        <label for="releaseYearInput">Linastumisaasta</label>
        <input id="releaseYearInput" name="releaseYearInput" type="number" min="1" step="1"
        value="<%= releaseYear || '' %>" required>
        <br>
        <label for="durationInput">Filmi kestus minutites</label>
        <input id="durationInput" name="durationInput" type="number" min="1" step="1"
        value="<%= duration || '' %>" required>
        <br>
        <label for="descriptionInput">Filmi kirjeldus</label>
        <textarea id="descriptionInput" name="descriptionInput" maxlength="1000"><%= description || '' %></textarea>
        <br>
        <input type="submit" value="Salvesta">
    </form>
    <p><%= notice %></p>
</body>
</html>
